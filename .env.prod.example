# Production environment — the live stack (upgraded in place via CI on merge).
# Deploy:  cp .env.prod .env && docker compose up -d --build
# Judge login once:  docker compose exec judge kiro-cli login --use-device-flow ...

# --- compose identity ---
COMPOSE_PROJECT_NAME=ai-portal-be
STACK=ai-portal-be
BACKEND_PORT=9000

# --- app config ---
DATABASE_URL=mysql+pymysql://<user>:<pass>@<host>:3306/rp_ai_portal?charset=utf8mb4
DEBUG=false
CORS_ORIGINS=https://<frontend-domain>

# --- security audit ---
AUDIT_ENABLED=true
AUDIT_JUDGE_URL=http://judge:8790
AUDIT_ADMIN_EID=ADMINMM
AUDIT_MR_REVIEWER=ezhgmio
AUDIT_MR_PROJECT=rp-ai/rp-ai-skill

# --- skill storage (prod: live skill repo, push on) ---
SKILL_REPO_HOST=/proj/rp_ait_prod/data/ai-portal-be/rp-ai-skill
SKILL_REPO_PATH=/proj/radio_ivc_rvc_workspace/ezhgmio/rp-ai-skill
SKILL_REPO_PUSH=true
LOG_DIR=/proj/rp_ait_prod/logs/ai-portal-be
SSH_DIR=/proj/rp_ait_prod/services/ai-portal-be/ssh

GITLAB_TOKEN=<token-with-api-scope>
