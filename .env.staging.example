# Staging / acceptance environment — coexists with prod (own project, port, data).
# Deploy:  cp .env.staging .env && docker compose up -d --build
# Then log the judge in once:
#   docker compose exec judge kiro-cli login --use-device-flow \
#     --license pro --identity-provider https://d-9367077c28.awsapps.com/start --region eu-west-1

# --- compose identity (isolates this stack from prod) ---
COMPOSE_PROJECT_NAME=ai-portal-audit-staging
STACK=ai-portal-audit-staging
BACKEND_PORT=9100

# --- app config ---
DATABASE_URL=mysql+pymysql://ai_portal:ai_portal@db:3306/ai_portal?charset=utf8mb4
# The db service is only started for this environment:
#   docker compose --profile local-db up -d --build
MYSQL_DATABASE=ai_portal
MYSQL_USER=ai_portal
MYSQL_PASSWORD=ai_portal
MYSQL_ROOT_PASSWORD=ai_portal_root
DEBUG=false
CORS_ORIGINS=*

# --- security audit ---
AUDIT_ENABLED=true
AUDIT_JUDGE_URL=http://judge:8790
AUDIT_ADMIN_EID=ADMINMM
AUDIT_MR_REVIEWER=
AUDIT_MR_PROJECT=rp-ai/rp-ai-skill

# --- skill storage (staging: isolated dir, no push to the live skill repo) ---
SKILL_REPO_HOST=/proj/rp_ait_prod/data/ai-portal-be-staging/rp-ai-skill
SKILL_REPO_PATH=/data/skillrepo
SKILL_REPO_PUSH=false
LOG_DIR=/proj/rp_ait_prod/logs/ai-portal-be-staging
SSH_DIR=/proj/rp_ait_prod/services/ai-portal-be-staging/ssh

GITLAB_TOKEN=

# Reconciliation: the sweep interval, and the shared secret that enables
# POST /api/audit/reconcile for a GitLab webhook (empty = endpoint disabled).
RECONCILE_INTERVAL=300
AUDIT_WEBHOOK_TOKEN=
