# Copy to .env and fill in real values.

# RSW AI Inventory
# Directory where the external tool deposits the two pre-generated HTML reports:
#   full_report_browser.html  — full inventory
#   delta_report_browser.html — delta (changes since last report)
# Leave empty to disable the file-fallback path (DB is the primary source now).
RSW_INVENTORY_DIR=/var/lib/rp-ai-portal/rsw-inventory
# API key for POST /api/rsw/inventory/upload (called by the external inventory
# tool, no JWT). Must match the value configured in the external tool.
# Empty = upload endpoint disabled (returns 403).
RSW_INVENTORY_API_KEY=

DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4

APP_NAME=RP AI Portal Backend
DEBUG=true

CORS_ORIGINS=http://localhost:4200

# Skill storage (git-managed directory for uploaded skills)
SKILL_REPO_PATH=/proj/radio_ivc_rvc_workspace/ezhgmio/rp-ai-skill
SKILL_REPO_PUSH=true
SKILL_REPO_REMOTE=origin
SKILL_REPO_BRANCH=main
GIT_AUTHOR_NAME=RP AI Portal
GIT_AUTHOR_EMAIL=rp-ai-portal@ericsson.com

# GitLab, read-only: Agent市场 sync + serving archives for download.
GITLAB_URL=https://gitlab.internal.ericsson.com
GITLAB_TOKEN=
GITLAB_AGENTS_GROUP=rp-ai/rp-ai-agent
GITLAB_TOOLS_GROUP=rp-ai/rp-ai-tools

# GitLab, write: agent packages uploaded through the portal, one project each.
#
# A **group access token** for this group (Owner + api,write_repository) — not the
# personal token above. That one is global read/write and is only used to read the
# two synced groups; scoping the writing credential to one group is the difference
# between "may create a project here" and "may delete anything I can reach".
# Empty => the zip upload answers 503 and says so, rather than taking a package it
# cannot store.
GITLAB_USER_AGENTS_GROUP=rp-ai/rp-ai-user-agents
GITLAB_USER_AGENTS_TOKEN=
# Reminder only. GitLab forces an expiry on group tokens, so this is a known
# future outage: on that day uploads start failing with 401, and the symptom is a
# long way from the cause.
GITLAB_USER_AGENTS_TOKEN_EXPIRES=2027-08-20
# Uploaded **tools** go to their own group, with its own group access token —
# same shape as the two lines above. Two credentials rather than one token on the
# parent `rp-ai` group: that one would only need a single variable, at the price of
# write access to everything under rp-ai (the skill repo and both synced groups
# included), which is exactly what splitting this credential off the personal PAT
# was for. Empty => tool package upload answers 503 and names this variable.
GITLAB_USER_TOOLS_GROUP=rp-ai/rp-ai-user-tools
GITLAB_USER_TOOLS_TOKEN=
GITLAB_USER_TOOLS_TOKEN_EXPIRES=

